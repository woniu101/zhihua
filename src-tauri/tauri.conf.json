{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知画",
  "version": "0.1.0",
  "identifier": "cn.zhihua.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "知画",
        "width": 1536,
        "height": 1024,
        "minWidth": 1280,
        "minHeight": 800,
        "decorations": false,
        "resizable": true,
        "center": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
